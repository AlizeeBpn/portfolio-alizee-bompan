# Hébergeur vidéo : Cloudinary.
# Le "cloud name" n'est pas un secret : il peut être exposé côté client (préfixe PUBLIC_).
PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name

# Utilisés uniquement par scripts/upload-videos.mjs (upload local). Ne JAMAIS exposer côté client.
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret