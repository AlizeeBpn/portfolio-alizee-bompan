---
export interface ProjectNavItem {
  url: string;
  thumbnail: string;
  title: string;
  description: string;
}

const { projects = [] } = Astro.props as { projects: ProjectNavItem[] };
---

{projects.length > 0 && (
  <section class="w-full py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <h2 class="font-['Pphatton',Georgia,sans-serif] text-[1.5rem] md:text-[2rem] font-bold text-text-heading mb-10">
        Explorer d'autres projets
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 md:gap-6">
        {projects.map((project) => (
          <a
            href={project.url}
            class="group flex flex-col rounded-2xl border border-[#e9e8ea] bg-white hover:border-brand-light/40 hover:shadow-[0_4px_24px_-8px_#7b4fd420] transition-all duration-300 no-underline overflow-hidden"
          >
            <div class="w-full h-44 md:h-56 overflow-hidden bg-[#f5f4f8]">
              <img
                src={project.thumbnail}
                alt={project.title}
                class="w-full h-full"
                style="object-fit:cover;width:100%;height:100%"
                loading="lazy"
              />
            </div>
            <div class="flex items-center justify-between gap-3 p-3 md:p-4">
              <div class="min-w-0 flex-1">
                <h3 class="font-['Plus_Jakarta_Sans',sans-serif] text-sm md:text-base font-semibold text-text-heading mb-0.5 group-hover:text-brand transition-colors line-clamp-1">
                  {project.title}
                </h3>
                <p class="font-['Plus_Jakarta_Sans',sans-serif] text-xs md:text-sm text-text-muted leading-[1.4] line-clamp-2">
                  {project.description}
                </p>
              </div>
              <span class="flex-shrink-0 inline-flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-full border-2 border-[#d5d2dc] group-hover:border-brand group-hover:bg-brand text-[#8b7fa8] group-hover:text-white transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}