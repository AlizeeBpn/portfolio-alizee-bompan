---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description, bodyClass = "w-full bg-[#f9f9ff]" } = Astro.props;
---

<!doctype html>
<html lang="fr" class="w-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
  <link rel="apple-touch-icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
  <!-- Polices Google auto-hébergées via @font-face (voir src/styles/global.css) -->
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
